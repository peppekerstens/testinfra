FROM opensuse/tumbleweed

RUN zypper --non-interactive refresh && zypper --non-interactive install -y \
    curl \
    wget \
    gawk \
    findutils \
    iproute2 \
    bind-utils \
    util-linux \
    e2fsprogs \
    dosfstools \
    parted \
    samba-client \
    cups-client \
    tar \
    gzip \
    libicu \
    iputils \
    procps \
    netcat-openbsd \
    && zypper --non-interactive clean --all

# Install PowerShell via direct tarball (RHEL repo RPMs not compatible with openSUSE)
RUN curl -sSL https://github.com/PowerShell/PowerShell/releases/download/v7.6.1/powershell-7.6.1-linux-x64.tar.gz \
        -o /tmp/pwsh.tar.gz \
    && mkdir -p /opt/microsoft/powershell/7 \
    && tar -xzf /tmp/pwsh.tar.gz -C /opt/microsoft/powershell/7 \
    && rm /tmp/pwsh.tar.gz \
    && ln -sf /opt/microsoft/powershell/7/pwsh /usr/local/bin/pwsh \
    && chmod +x /opt/microsoft/powershell/7/pwsh

RUN pwsh -NoProfile -NonInteractive -Command \
    "Install-Module -Name Pester -MinimumVersion 5.2.0 -Force -SkipPublisherCheck -Scope AllUsers"

RUN pwsh -NoProfile -NonInteractive -Command \
    "Install-Module -Name PSScriptAnalyzer -Force -SkipPublisherCheck -Scope AllUsers"

WORKDIR /module
CMD ["pwsh", "-NoProfile", "-Command", "Invoke-Pester -Output Detailed"]
