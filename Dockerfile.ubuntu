FROM ubuntu:24.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install prerequisites
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    apt-transport-https \
    software-properties-common \
    # Tools used by Linux modules
    iproute2 \
    dnsutils \
    systemd \
    util-linux \
    fdisk \
    e2fsprogs \
    dosfstools \
    parted \
    samba-common-bin \
    cups-client \
    apt-utils \
    iputils-ping \
    procps \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Install PowerShell via Microsoft APT repo
RUN curl -sSL https://packages.microsoft.com/config/ubuntu/24.04/packages-microsoft-prod.deb -o /tmp/packages-microsoft-prod.deb \
    && dpkg -i /tmp/packages-microsoft-prod.deb \
    && rm /tmp/packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y powershell \
    && rm -rf /var/lib/apt/lists/*

# Install Pester
RUN pwsh -NoProfile -NonInteractive -Command \
    "Install-Module -Name Pester -MinimumVersion 5.2.0 -Force -SkipPublisherCheck -Scope AllUsers"

# Install PSScriptAnalyzer
RUN pwsh -NoProfile -NonInteractive -Command \
    "Install-Module -Name PSScriptAnalyzer -Force -SkipPublisherCheck -Scope AllUsers"

WORKDIR /module
CMD ["pwsh", "-NoProfile", "-Command", "Invoke-Pester -Output Detailed"]
